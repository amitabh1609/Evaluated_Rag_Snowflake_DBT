# ── LLM providers ────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── Qdrant ───────────────────────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=                        # leave empty for local docker

# ── Langfuse ─────────────────────────────────────────────────────────────────
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000

# ── Embedding model ───────────────────────────────────────────────────────────
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
RERANKER_MODEL=BAAI/bge-reranker-large

# ── Generation ────────────────────────────────────────────────────────────────
GENERATOR_MODEL=claude-sonnet-4-6      # or gpt-4o
REWRITER_MODEL=claude-haiku-4-5-20251001  # or gpt-4o-mini

# ── Retrieval knobs ───────────────────────────────────────────────────────────
TOP_K_VECTOR=20
TOP_K_BM25=20
TOP_K_RERANK=5
RRF_K=60

# ── Evaluation ────────────────────────────────────────────────────────────────
FAITHFULNESS_THRESHOLD=0.80

# ── Crawl ────────────────────────────────────────────────────────────────────
CRAWL_USER_AGENT=evaluated-rag-portfolio/0.1 (contact: your@email.com)
CRAWL_DELAY_SECS=1.0
